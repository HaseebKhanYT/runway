# Database
# Local: matches docker-compose. Production: Railway injects its own value.
DATABASE_URL=postgresql://runway:runway@localhost:5433/runway

# Clerk — create an app at https://dashboard.clerk.com
# Local dev of apps/web also works with no keys (Clerk keyless mode).
# Use pk_test_/sk_test_ for the dev instance, pk_live_/sk_live_ in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Themed in-app auth pages instead of Clerk's hosted pages (apps/web)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/runway
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/runway

# Web -> API base URL (apps/web). Production: the deployed API origin.
NEXT_PUBLIC_API_URL=http://localhost:8787

# API -> allowed browser origin(s), comma-separated (apps/api).
# Required in production: CORS rejects anything else, and Clerk tokens are only
# accepted from these origins. Production: the deployed web origin.
WEB_ORIGIN=http://localhost:3000

# --- Plaid (reserved — not used in v1) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
