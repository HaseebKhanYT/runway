{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "CLERK_SECRET_KEY",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_CLERK_SIGN_IN_URL",
        "NEXT_PUBLIC_CLERK_SIGN_UP_URL",
        "NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL",
        "NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL",
        "NEXT_PUBLIC_API_URL"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false,
      "inputs": ["prisma/schema.prisma"],
      "env": ["DATABASE_URL"]
    },
    "test": {
      "dependsOn": []
    },
    "test:integration": {
      "dependsOn": [],
      "cache": false,
      "env": ["DATABASE_URL", "DEV_AUTH_BYPASS"]
    },
    "typecheck": {
      "dependsOn": []
    },
    "@runway/api#typecheck": {
      "dependsOn": ["@runway/api#db:generate"]
    },
    "@runway/api#test:integration": {
      "dependsOn": ["@runway/api#db:generate"],
      "cache": false,
      "env": ["DATABASE_URL", "DEV_AUTH_BYPASS"]
    }
  }
}
